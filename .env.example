# Copie a .env y complete. NUNCA suba .env a Git.
LLM_PROVIDER=fake            # fake | ollama | openai | anthropic
JWT_SECRET=genere-uno-con-python-c-import-secrets-print-secrets.token_hex-32

# Modelo según la memoria del equipo: ver INSTALACION.md. Verifique el tag con: ollama list
OLLAMA_MODEL=qwen3:14b       # principal: español, JSON y herramientas
# OLLAMA_MODEL=gpt-oss:20b   # segundo "proveedor" para comparar (sesión 8)
# OLLAMA_MODEL=qwen3:4b-instruct  # equipos de 16 GB (con 8 GB: qwen3:1.7b)
OLLAMA_REASONING=none         # none = responde en segundos; low|medium|high = piensa antes (más lento)
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_URL=http://localhost:11434/v1   # desde Docker o el Dev Container: http://host.docker.internal:11434/v1

OPENAI_API_KEY=
OPENAI_MODEL=                # consulte el modelo vigente en la documentación del proveedor

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5     # claude-sonnet-5-5 cuesta la mitad
